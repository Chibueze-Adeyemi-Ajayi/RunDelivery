                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:3000/socket.io/?EIO=4&transport=polling",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "3000",
                            "path": [
                                "socket.io",
                                ""
                            ],
                            "query": [
                                {
                                    "key": "EIO",
                                    "value": "4"
                                },
                                {
                                    "key": "transport",
                                    "value": "polling"
                                }
                            ]
                        },
                        "description": "This request simulates the HTTP polling handshake of Socket.IO. In Postman, prefer creating a **WebSocket Request** set to **Socket.IO** mode pointing to `ws://localhost:3000`."
                    },
                    "response": []
                }
            ],
            "description": "For full real-time testing:\n\n1. Use Postman's **WebSocket Request** mode.\n2. Select **Socket.IO** from the request type dropdown.\n3. Connect to `ws://localhost:3000`.\n4. Events:\n    - Emit `join_order` with `orderId` String.\n    - Emit `update_location` with `{ \"orderId\": \"...\", \"latitude\": 10, \"longitude\": 10 }` JSON.\n    - Listen for `driver_location`."
        }
